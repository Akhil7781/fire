# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:
#      copy .env.example .env   (Windows)
#      cp .env.example .env     (Linux/macOS)
# 2. Fill in your NASA FIRMS MAP_KEY below.
# 3. NEVER commit your actual .env file or expose your key in logs or code.
# ==============================================================================

# NASA FIRMS MAP KEY (Request from: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_firms_map_key_here

# Geoapify API Key for Proximity & Basemap (Request from: https://www.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Directory containing the 73 FIRMS VIIRS NOAA-20 2025 CSV files
RAW_DATA_DIR=data/raw

# Directory containing the 2024 Q4 India VIIRS NOAA-20 context burn-in CSV files
RAW_CONTEXT_DIR=data/raw_context

# Optional project configuration
PROCESSED_DATA_DIR=data/processed
CHECKPOINT_DIR=checkpoints
LOG_DIR=logs
RANDOM_SEED=42

# Operational System Configuration (Stage 8.37+)
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///data/operational.db
# For PostgreSQL/PostGIS in production:
# DATABASE_URL=postgresql://ds08_admin:your_secure_password@localhost:5432/ds08_operational

