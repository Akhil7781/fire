  "protocol_proposals_evaluation": {
    "proposal_a": {
      "proposal_id": "PROPOSAL_A_750M_MAX_ASSOCIATION_RADIUS",
      "decision": "DEFER",
      "policy_status": "ASSOCIATION_RADIUS_POLICY = NOT_YET_FROZEN",
      "evaluation_reasoning": "A rigid 750m association radius is scientifically unjustified as a universal rule. Spatial uncertainty in satellite thermal detections is governed by sensor scan angle (VIIRS 375m expands to ~800m at scan edge; MODIS 1km expands to 2km), geolocation parallax, and fire spread dynamics. In PILOT_01_NORTH, the target was 2.31 km away, which was rejected on physical discontinuity and independent parcel boundaries, not an arbitrary 750m cutoff. Provisional principle established: 'Spatial association must be supported by the visual target and contextual relationship; no universal radius is frozen until validated on a larger annotated sample.'"
    },
    "proposal_b": {
      "proposal_id": "PROPOSAL_B_MONTANE_B12_GT_0_5_THRESHOLD",
      "decision": "REJECT",
      "policy_status": "MONTANE_B12_THRESHOLD_POLICY = REJECTED_AS_MANDATORY_CRITERION",
      "evaluation_reasoning": "A hard radiometric threshold (B12 > 0.5) is physically flawed. Real smoldering fires, cold post-fire burn scars, and sub-pixel burns regularly exhibit B12 <= 0.50. Mandating B12 > 0.5 would systematically discard valid cool burn scars. In PILOT_13_EAST, the target was adjudicated as UNRESOLVED because of single-date optical ambiguity between montane terrain shadow and vegetative disturbance, which is correctly and natively handled by the existing UNRESOLVED protocol without introducing an unphysical radiometric cutoff."
    },
    "protocol_versioning": {
      "action": "RETAIN_VERSION_1_0",
      "protocol_version": "v1.0",
      "version_decision": "NO_PROTOCOL_CHANGE_REQUIRED",
      "justification": "Guidelines v1.0 and ds08_annotation_schema.json proved completely robust and expressive across all pilot cases without modification. Arbitrary thresholds were rejected or deferred; baseline v1.0 remains fully authoritative."
